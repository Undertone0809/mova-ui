{
  "name": "@mova-ui/react",
  "version": "0.8.0",
  "description": "Mova. Make interfaces feel alive. React motion components and an offline source CLI.",
  "private": false,
  "type": "module",
  "keywords": [
    "react",
    "animation",
    "motion",
    "components",
    "mova"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./catalog/*": {
      "types": "./dist/catalog/*.d.ts",
      "import": "./dist/catalog/*.js",
      "require": "./dist/catalog/*.js"
    },
    "./registry/manifest.json": "./registry/manifest.json",
    "./registry/*.json": "./registry/*.json",
    "./package.json": "./package.json",
    "./blocks": {
      "types": "./dist/blocks/index.d.ts",
      "import": "./dist/blocks/index.js",
      "require": "./dist/blocks/index.js"
    },
    "./blocks/styles.css": "./dist/blocks/styles.css",
    "./blocks/sources.json": "./dist/blocks/sources.json",
    "./blocks/assets/*": "./dist/blocks/assets/*"
  },
  "bin": {
    "mova": "./bin/mova.mjs"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/styles.css",
    "bin/mova.mjs",
    "registry/manifest.json",
    "registry/*.json",
    "README.md",
    "dist/blocks/**"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.mjs",
    "test:consumer": "node tests/npm-consumer.mjs",
    "verify": "npm run build && npm test && npm run test:consumer"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource/anton": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.24",
    "glimm": "0.3.0",
    "gsap": "^3.15.0",
    "lucide-react": "^0.546.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.3.0",
    "voice-glow": "0.2.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.14",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Undertone0809/mova-ui.git"
  },
  "bugs": {
    "url": "https://github.com/Undertone0809/mova-ui/issues"
  },
  "homepage": "https://github.com/Undertone0809/mova-ui#readme"
}
